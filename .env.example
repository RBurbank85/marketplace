# Application
APP_NAME=maie
ENVIRONMENT=development
DEBUG=false

# Database
SQLITE_PATH=database/listings.db

# Search behavior
SEARCH_INTERVAL=15
SEARCH_RADIUS=25
SCHEDULER_AUTOSTART=true

# Notifications
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=

# Opportunity thresholds
MINIMUM_FLIPSCORE=60
MINIMUM_EXPECTED_PROFIT=20.0

# Logging
LOGGING_LEVEL=INFO

# Security
# Development-only convenience switch. Keep authentication enabled for deployments.
API_KEY=
API_AUTH_ENABLED=false
# Set SECRET_KEY to a locally generated value for deployments that use signing.
SECRET_KEY=
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Collector and category enablement
ENABLED_COLLECTORS=craigslist,ebay
ENABLED_CATEGORIES=electronics,tools,audio,base,cameras,guitars,medical,networking

# Collector configuration (JSON). Craigslist supports bounded pagination,
# per-request timeout, and conservative per-collector pacing. Credentials are
# not used or sent by Craigslist. obey_robots defaults to true (compliant);
# set to false per collector to opt out of robots.txt checks.
#
# eBay uses the Browse API (client credentials grant flow). Credentials are
# the App ID (client_id) and Cert ID (client_secret) from the eBay Developer
# Program. eBay is an authenticated API and does not use robots.txt.
# Uncomment ENABLED_COLLECTORS below and add an ebay entry to COLLECTOR_CONFIGS
# to enable. Credentials are stored as SecretStr and excluded from config dumps.
# Set base_url to https://api.sandbox.ebay.com for sandbox keys; omit it (or use
# https://api.ebay.com) for production keys.
#
# ENABLED_COLLECTORS=craigslist,ebay
# COLLECTOR_CONFIGS={"craigslist":{"queries":["receiver","turntable","speaker","amplifier","headphones","microphone","subwoofer","guitar","camera","lens","laptop","server","drill","impact driver","circular saw","miter saw","battery","tool kit","compressor","grinder","power tool","vintage","estate","moving"],"locations":["denver"],"pagination_limit":2,"request_timeout":10,"rate_limit_per_minute":30},"ebay":{"queries":["receiver","turntable","speaker","amplifier","guitar","camera","lens","laptop","drill","circular saw","battery","power tool"],"pagination_limit":2,"request_timeout":15,"rate_limit_per_minute":120;
COLLECTOR_CONFIGS={"craigslist":{"queries":["receiver","turntable","speaker","amplifier","headphones","microphone","subwoofer","guitar","camera","lens","laptop","server","drill","impact driver","circular saw","miter saw","battery","tool kit","compressor","grinder","power tool","vintage","estate","moving"],"locations":["denver"],"pagination_limit":2,"request_timeout":10,"rate_limit_per_minute":30}}
