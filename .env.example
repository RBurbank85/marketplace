# Application
APP_NAME=maie
ENVIRONMENT=development
DEBUG=false

# Database
SQLITE_PATH=database/listings.db

# Search behavior
SEARCH_INTERVAL=15
SEARCH_RADIUS=25
SCHEDULER_AUTOSTART=false

# Notifications
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=

# Opportunity thresholds
MINIMUM_FLIPSCORE=60
MINIMUM_EXPECTED_PROFIT=20.0

# Logging
LOGGING_LEVEL=INFO

# Security
API_KEY=maie-development-api-key
API_AUTH_ENABLED=true
SECRET_KEY=secret-key-change-me-in-production
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Collector and category enablement
ENABLED_COLLECTORS=craigslist
ENABLED_CATEGORIES=electronics,tools,audio,base,cameras,guitars,medical,networking

# Collector configuration (JSON)
COLLECTOR_CONFIGS={"craigslist":{"queries":["electronics","tools","audio","base","cameras","guitars","medical","networking"],"locations":["denver"],"pagination_limit":2,"request_timeout":10,"rate_limit_per_minute":30}}
