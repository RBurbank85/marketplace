# Application
APP_NAME=maie
ENVIRONMENT=development
DEBUG=false

# Database
SQLITE_PATH=database/listings.db

# Search behavior
SEARCH_INTERVAL=15
SEARCH_RADIUS=25
SCHEDULER_AUTOSTART=false

# Notifications
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=

# Opportunity thresholds
MINIMUM_FLIPSCORE=60
MINIMUM_EXPECTED_PROFIT=20.0

# Logging
LOGGING_LEVEL=INFO

# Security
# Development-only convenience switch. Keep authentication enabled for deployments.
API_KEY=
API_AUTH_ENABLED=false
# Set SECRET_KEY to a locally generated value for deployments that use signing.
SECRET_KEY=
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Collector and category enablement
ENABLED_COLLECTORS=craigslist
ENABLED_CATEGORIES=electronics,tools,audio,base,cameras,guitars,medical,networking

# Collector configuration (JSON). Craigslist supports bounded pagination,
# per-request timeout, and conservative per-collector pacing. Credentials are
# not used or sent by Craigslist.
COLLECTOR_CONFIGS={"craigslist":{"queries":["electronics","tools","audio","base","cameras","guitars","medical","networking"],"locations":["denver"],"pagination_limit":2,"request_timeout":10,"rate_limit_per_minute":30}}
