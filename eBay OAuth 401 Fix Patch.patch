+def test_config_update_ebay_credentials_preserved_when_blank(client: TestClient, monkeypatch):
+    """When credentials are submitted with blank values, existing credentials are preserved."""
+    from config.settings import CollectorConfig
+    from pydantic import SecretStr
+
+    original_configs = dict(settings.collector_configs)
+    settings.collector_configs = {
+        "ebay": CollectorConfig(
+            queries=["guitar"],
+            credentials={"client_id": SecretStr("existing-app-id"), "client_secret": SecretStr("existing-cert")},
+        )
+    }
+    try:
+        # Submit config update with blank credentials — should preserve existing
+        response = client.put(
+            "/config/",
+            json={
+                "collector_configs": {
+                    "ebay": {
+                        "queries": ["guitar", "amp"],
+                        "credentials": {"client_id": "", "client_secret": ""},
+                    }
+                }
+            },
+        )
+        assert response.status_code == 200
+        # Verify existing credentials are preserved
+        ebay_config = settings.collector_configs["ebay"]
+        assert ebay_config.credentials["client_id"].get_secret_value() == "existing-app-id"
+        assert ebay_config.credentials["client_secret"].get_secret_value() == "existing-cert"
+        assert ebay_config.queries == ["guitar", "amp"]
+    finally:
+        settings.collector_configs = original_configs
+
+
+def test_config_update_ebay_credentials_updated_when_provided(client: TestClient, monkeypatch):
+    """When new credential values are provided, they replace the existing ones."""
+    from config.settings import CollectorConfig
+    from pydantic import SecretStr
+
+    original_configs = dict(settings.collector_configs)
+    settings.collector_configs = {
+        "ebay": CollectorConfig(
+            queries=["guitar"],
+            credentials={"client_id": SecretStr("old-app-id"), "client_secret": SecretStr("old-cert")},
+        )
+    }
+    try:
+        response = client.put(
+            "/config/",
+            json={
+                "collector_configs": {
+                    "ebay": {
+                        "queries": ["guitar"],
+                        "credentials": {"client_id": "new-app-id", "client_secret": "new-cert"},
+                        "base_url": "https://api.sandbox.ebay.com",
+                    }
+                }
+            },
+        )
+        assert response.status_code == 200
+        ebay_config = settings.collector_configs["ebay"]
+        assert ebay_config.credentials["client_id"].get_secret_value() == "new-app-id"
+        assert ebay_config.credentials["client_secret"].get_secret_value() == "new-cert"
+        assert ebay_config.base_url == "https://api.sandbox.ebay.com"
+        # Credentials should not appear in the public dump
+        assert "credentials" not in response.json()["collector_configs"]["ebay"]
+    finally:
+        settings.collector_configs = original_configs
+
+
